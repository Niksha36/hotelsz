<!doctype html>
<html lang="ru">
<head>
    <meta charset="utf-8">
    <title>Admin Login</title>

    <style>
        body {
            margin: 0;
            font-family: 'Inter', sans-serif;
            background: #f7f7f7;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
        }

        .login-wrapper {
            width: 100%;
            max-width: 380px;
            background: #fff;
            padding: 32px;
            border-radius: 16px;
            box-shadow: 0 8px 22px rgba(0,0,0,0.08);
            animation: fadeIn .5s ease;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to   { opacity: 1; transform: translateY(0); }
        }

        .title {
            font-size: 28px;
            font-weight: 700;
            margin-bottom: 24px;
            text-align: center;
            color: #222;
        }

        .form-group {
            margin-bottom: 18px;
        }

        label {
            display: block;
            font-size: 14px;
            margin-bottom: 6px;
            color: #333;
        }

        input {
            width: 100%;
            padding: 12px 14px;
            font-size: 15px;
            border: 1px solid #ddd;
            border-radius: 12px;
            box-sizing: border-box;
            transition: border-color .2s, box-shadow .2s;
        }

        input:focus {
            border-color: #0071c2;
            box-shadow: 0 0 0 3px rgba(0,113,194,0.15);
            outline: none;
        }

        .error {
            background: #ffefef;
            border-left: 4px solid #d33;
            padding: 10px 14px;
            border-radius: 8px;
            font-size: 14px;
            color: #b00;
            margin-bottom: 16px;
        }

        button {
            width: 100%;
            margin-top: 10px;
            padding: 12px;
            font-size: 16px;
            font-weight: 600;
            background: #0071c2;
            color: white;
            border: none;
            border-radius: 12px;
            cursor: pointer;
            transition: background .2s;
        }

        button:hover {
            background: #005a9c;
        }
    </style>
</head>

<body>

<div class="login-wrapper">

    <div class="title">Вход в админку</div>

    {% if error %}
    <div class="error">{{ error }}</div>
    {% endif %}

    <form method="post" action="{{ path('admin_login') }}">
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

        <div class="form-group">
            <label>Телефон или email</label>
            <input type="text" name="phone" required value="{{ last_username|default('') }}">
        </div>

        <div class="form-group">
            <label>Пароль</label>
            <input type="password" name="password" required>
        </div>

        <button type="submit">Войти</button>
    </form>

</div>

</body>
</html>
